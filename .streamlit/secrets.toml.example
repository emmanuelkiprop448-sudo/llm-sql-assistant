# Copy this file to .streamlit/secrets.toml and fill it in.
# secrets.toml is in .gitignore: never commit a real API key.

# Option 1: Ollama on your own computer (free, runs locally; install from ollama.com,
# then run: ollama pull qwen2.5-coder:7b)
LLM_MODEL = "qwen2.5-coder:7b"
LLM_API_KEY = "ollama"
LLM_BASE_URL = "http://localhost:11434/v1"

# Option 2: a hosted provider with an OpenAI-compatible API
# LLM_MODEL = "model name from your provider"
# LLM_API_KEY = "your API key"
# LLM_BASE_URL = "your provider's OpenAI-compatible endpoint (leave this line out for OpenAI itself)"
